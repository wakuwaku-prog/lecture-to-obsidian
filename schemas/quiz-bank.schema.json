{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.dsh/lecture-to-obsidian/quiz-bank.schema.json",
  "title": "题库 JSON v1",
  "description": "严格对齐 C:\\Users\\epiph\\Documents\\Obsidian\\细胞生物学和组织学\\刷题工具\\题库格式规范.md（该库 status: verified，规则来自前端实际校验）。产物必须能被 刷题工具/开始刷题.html 直接导入判分。规范明确「额外未知字段不执行且不保留」，故不擅自扩展字段。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "questions"],
  "properties": {
    "schemaVersion": { "const": 1, "description": "必须是数字 1，不能写字符串 \"1\"" },
    "id": { "$ref": "#/definitions/stableId", "description": "全局稳定题库 ID；不同题库不能共用" },
    "version": { "type": "string", "minLength": 1, "description": "非空字符串，建议语义版本号；更新内容时递增" },
    "title": { "$ref": "#/definitions/bilingualPlain", "description": "纯文字双语，英文不能为空，不含图片" },
    "description": { "$ref": "#/definitions/bilingualPlain", "description": "可选；英文可为空，不含图片" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/definitions/question" }
    }
  },

  "definitions": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": { "enum": ["constructor", "prototype", "__proto__"] },
      "description": "英文字母或数字开头，其后允许字母数字点下划线短横线；长度 1–100"
    },

    "bilingualPlain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en"],
      "properties": {
        "en": { "type": "string" },
        "zh": { "type": "string" }
      }
    },

    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^data:image/(png|jpeg|webp|gif);base64,",
          "description": "只接受内嵌 data URL；不接受网络 URL、本机路径、相对路径或 SVG"
        },
        "alt": { "$ref": "#/definitions/bilingualPlain", "description": "纯文字双语，英文非空；供读屏与加载失败时使用" },
        "caption": { "$ref": "#/definitions/bilingualPlain", "description": "可选纯文字图注；英文可空" }
      }
    },

    "contentBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en"],
      "description": "双语纯文本，可追加 images（每处最多 8 张）。文字不解释 HTML/Markdown/LaTeX",
      "properties": {
        "en": { "type": "string" },
        "zh": { "type": "string" },
        "images": { "type": "array", "maxItems": 8, "items": { "$ref": "#/definitions/image" } }
      }
    },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "description": "如 S84 或课件文件名" },
        "pages": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "description": "PDF 阅读器页序。不能混用幻灯片印刷页码"
        },
        "note": { "type": "string" }
      }
    },

    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "answer", "explanation"],
      "properties": {
        "id": { "$ref": "#/definitions/stableId", "description": "题库内唯一，且不随排序变动；推荐 L02-001" },
        "type": { "enum": ["single", "multiple", "boolean", "fill"] },
        "prompt": { "$ref": "#/definitions/contentBlock" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 26,
          "description": "single / multiple 必填；boolean / fill 不需要",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "$ref": "#/definitions/stableId", "description": "题目内唯一；推荐 A/B/C/D" },
              "text": { "$ref": "#/definitions/contentBlock" }
            }
          }
        },
        "answer": {
          "description": "single=选项 id 字符串；multiple=非空无重复的选项 id 数组（顺序无关，漏选多选选错均判错）；boolean=JSON 布尔值（不是字符串）；fill=按空位顺序的参考答案数组",
          "oneOf": [
            { "$ref": "#/definitions/stableId" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/stableId" } },
            { "type": "boolean" },
            { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/definitions/contentBlock" } }
          ]
        },
        "answerContent": {
          "$ref": "#/definitions/contentBlock",
          "description": "选择题/判断题作答后补充展示，可含图片。不参与判分，不得与 answer 矛盾"
        },
        "explanation": { "$ref": "#/definitions/contentBlock", "description": "必填。解释为什么正确以及有意义的适用条件；本 skill 要求指回课件页码或原文" },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "用于筛选。避免使用界面保留值 all"
        },
        "difficulty": { "enum": ["basic", "applied"] },
        "source": { "$ref": "#/definitions/source" }
      }
    }
  }
}
